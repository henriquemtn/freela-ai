generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  potential
  contacted
  in_progress
  working
  completed
  rejected // Limbo: not shown on the Kanban
}

enum WebsiteStatus {
  not_found
  social_only
  outdated
  active
  unknown
}

enum Priority {
  low
  medium
  high
}

enum RejectionReason {
  no_interest
  no_response
  already_has_provider
  no_budget
  not_a_fit
  invalid_business
  duplicate
  other
}

enum ActivityType {
  note
  stage_change
  call
  message
  email
  meeting
}

model Company {
  id       String  @id @default(cuid())
  name     String
  category String?
  city     String?
  state    String?
  address  String?
  phone    String?

  websiteUrl    String?
  websiteStatus WebsiteStatus @default(unknown)

  stage          Stage     @default(potential)
  generatedScore Int? // filled by research (Phase 4)
  manualPriority Priority?

  estimatedValueCents Int?
  nextActionAt        DateTime? @db.Timestamptz // cache: earliest open task dueAt
  lastInteractionAt   DateTime? @db.Timestamptz

  rejectionReason RejectionReason?
  rejectionNote   String?
  closedAt        DateTime?        @db.Timestamptz

  notes         String? // user-authored
  outreachDraft String? // unsent first-contact message being edited

  // Discovery provenance; providerPlaceId only for providers with stable IDs.
  provider        String?
  providerPlaceId String?

  contacts        Contact[]
  activities      Activity[]
  tasks           Task[]
  researchJobs    ResearchJob[]
  deals           Deal[]
  researchReports ResearchReport[]

  discoveredAs DiscoveryCandidate[] @relation("PromotedFrom")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([provider, providerPlaceId])
  @@index([stage])
  @@index([name])
  @@index([city])
  @@index([nextActionAt])
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String?
  role  String?
  email String?
  phone String?
  notes String?

  // LGPD: where and when it was collected
  source      String?
  collectedAt DateTime? @db.Timestamptz
  optedOut    Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([companyId])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      ActivityType
  body      String?
  fromStage Stage?
  toStage   Stage?

  occurredAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([companyId, occurredAt])
}

model Task {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title       String
  notes       String?
  dueAt       DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([completedAt, dueAt])
  @@index([companyId])
}

enum RunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum CandidateStatus {
  pending
  promoted
  dismissed
  duplicate // same provider place as an existing company
}

model DiscoveryRun {
  id       String    @id @default(cuid())
  provider String // "claude" | "sample"
  area     String // e.g. "Florianópolis, SC"
  terms    String[]
  status   RunStatus @default(queued)

  foundCount     Int     @default(0)
  duplicateCount Int     @default(0)
  failedCount    Int     @default(0)
  error          String?

  startedAt  DateTime? @db.Timestamptz
  finishedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  candidates DiscoveryCandidate[]

  @@index([status, createdAt])
}

// A search result awaiting review; becomes a Company only when the user promotes it.
model DiscoveryCandidate {
  id              String          @id @default(cuid())
  runId           String
  run             DiscoveryRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider        String
  providerPlaceId String
  status          CandidateStatus @default(pending)
  term            String

  name       String
  category   String?
  address    String?
  city       String?
  state      String?
  phone      String?
  websiteUrl String?
  sourceUrl  String? // page where the result was found

  companyId String? // set once promoted or when an exact duplicate
  company   Company? @relation("PromotedFrom", fields: [companyId], references: [id], onDelete: SetNull)

  fetchedAt DateTime @default(now()) @db.Timestamptz

  @@unique([runId, provider, providerPlaceId])
  @@index([provider, providerPlaceId])
  @@index([status, fetchedAt])
}

// First-contact message with {variables}; websiteStatus picks the default per company.
model MessageTemplate {
  id            String         @id @default(cuid())
  name          String
  body          String
  websiteStatus WebsiteStatus?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// Asynchronous Claude research of one company, processed by the worker.
model ResearchJob {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    RunStatus @default(queued)
  error     String?

  startedAt  DateTime? @db.Timestamptz
  finishedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  report ResearchReport?

  @@index([status, createdAt])
  @@index([companyId])
}

// Validated research output. Detailed findings are JSON (shape enforced by
// Zod in src/research/schema.ts); score is computed in code from the signals.
model ResearchReport {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?      @unique
  job       ResearchJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  websiteStatus  WebsiteStatus
  websiteUrl     String?
  confidence     Float // 0..1, as reported by the agent
  summary        String
  score          Int
  scoreBreakdown Json
  findings       Json // signals, opportunities, services, channels, sources, limitations

  model     String?
  costUsd   Float? // diagnostic metadata, not used for money arithmetic
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([companyId, createdAt])
}

enum DealStatus {
  open // em negociação
  proposal // proposta enviada
  won
  lost
}

// Commercial opportunity for a company; a company can have many over time (repeat business).
model Deal {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title      String
  service    String?
  valueCents Int?
  status     DealStatus @default(open)
  notes      String?

  proposalSentAt DateTime? @db.Timestamptz
  closedAt       DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([companyId])
  @@index([status, closedAt])
}
