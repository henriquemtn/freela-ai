# Local Postgres. With this repo's docker-compose: port 5433.
DATABASE_URL="postgresql://freela:freela@localhost:5433/freela"

# Lead discovery runs the Claude CLI (`claude`, logged in) with web search.
# Model alias for discovery searches (default: sonnet).
FREELA_CLAUDE_MODEL="sonnet"
# Set to "sample" to use clearly labeled fake data instead of Claude.
# FREELA_DISCOVERY_PROVIDER="sample"
